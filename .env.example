CODEIN_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Signer (use one). Prefer JSON array when this is non-empty; otherwise base58 below is used.
# JSON array of 64 secret key bytes, e.g. [1,2,3,...] from a key export — never commit real values.
SOLANA_SIGNER_SECRET_KEY=

# Base58-encoded full secret key. Only used if SOLANA_SIGNER_SECRET_KEY is unset or empty.
# SOLANA_SIGNER_SECRET_KEY_BASE58=

CODEIN_MODE=real
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local default — SQLite is enough for cloning, learning, and local demos (no external DB account).
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/code-in-receipts.sqlite

# Optional hosted deployment (serverless platforms such as Vercel need a persistent store):
# DATABASE_PROVIDER=postgres
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Postgres is included in this starter; Neon, Supabase, or any Postgres host works.
# You can also adapt the receipt index to your existing app database later.
