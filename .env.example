CODEIN_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Dear Future alias (optional): CODEIN_SOLANA_NETWORK=devnet
# Dear Future alias (optional): CODEIN_RPC_URL=https://api.devnet.solana.com

# Signer (use one). Prefer JSON array when this is non-empty; otherwise base58 below is used.
# JSON array of 64 secret key bytes, e.g. [1,2,3,...] from a key export — never commit real values.
SOLANA_SIGNER_SECRET_KEY=

# Base58-encoded full secret key. Only used if SOLANA_SIGNER_SECRET_KEY is unset or empty.
# SOLANA_SIGNER_SECRET_KEY_BASE58=
# Dear Future alias (optional): CODEIN_SIGNER_PRIVATE_KEY=

CODEIN_MODE=real
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_PATH=./data/code-in-receipts.sqlite
