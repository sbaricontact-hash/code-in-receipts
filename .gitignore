# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# allow safe example env files
!.env.example
!.env.sample

# local signer keys / wallets
.keys/
*.keypair.json
*-signer.json
*-signer.pub.txt

# local sqlite database files
data/*.sqlite
data/*.sqlite3
data/*.db
data/*.sqlite-shm
data/*.sqlite-wal
data/*.db-shm
data/*.db-wal

# keep data folder placeholder if needed
!data/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo

# OS / editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/